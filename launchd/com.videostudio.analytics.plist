<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.videostudio.analytics</string>
  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/.venv/bin/studio</string>
    <string>sync</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>STUDIO_ROOT</key>
    <string>__ROOT__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__ROOT__/data/sync.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/data/sync.log</string>
</dict>
</plist>
