PEXELS_API_KEY=
# https://pixabay.com/api/docs/  (免费)
PIXABAY_API_KEY=

DEFAULT_VOICE=zh-CN-YunxiNeural
DEFAULT_RESOLUTION=1920x1080
FPS=30

# 可选：缩略图 / 叠字使用的字体文件，和字幕的字体名（字幕由 libass 按字体名查找）
